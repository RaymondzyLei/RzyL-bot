# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 本地配置与密钥：提交 .env.example，不要提交 .env
.env
.env.*
!.env.example

# NapCat 运行时生成的配置（含 WebUI token、机器人 QQ 号）
# 目录本身要保留：容器 bind mount 需要它存在且属主为 NAPCAT_UID
napcat/config/*
!napcat/config/.gitkeep

# 交接文档：仅本地使用，不入库
handoff/

# 运行时数据：记忆库（SQLite）、落盘的群图片等
# 容器通过 bind mount 写这里，所以目录要在宿主机上真实存在
data/

.pytest_cache/

# ZCode 工具自己的忽略清单（每台机器各自生成），不是项目文件
.zcodeignore
