# 复制为 .env 使用：cp .env.example .env
# 本文件是公开仓库的一部分：**只放占位符与说明，绝不写真实密钥、QQ 号、群号**。
# Docker 部署时这些值由 docker-compose.yml 的 env_file 注入容器；本机直接
# `uv run python bot.py` 时由 pydantic-settings 读取本文件。所有 RZYL_* 都有默认值，
# 不配也能启动——但聊天模型缺密钥时记忆功能会明确关闭（见下方说明）。

DRIVER=~fastapi
HOST=0.0.0.0
PORT=8080
# 空串表示命令不需要前缀，直接发「大雾1 关键词」即可
COMMAND_START=[""]
COMMAND_SEP=[""]

# 本地开发时是否启用 console 适配器（终端里直接聊天测试）；容器里设为 false
ENABLE_CONSOLE_ADAPTER=true

# NapCat WebUI 登录令牌（docker compose 会读这一项），务必改成自己的
WEBUI_TOKEN=changeme

# —— 采集范围 ——
# 初始监听的群号，逗号分隔或 JSON 数组；默认空表示一个群都不监听（靠运行时开关开）
RZYL_GROUP_WHITELIST=

# —— 窗口与去重 ——
# 一个窗口最多攒多少条消息：到了就无条件成窗（不受下面的最小条数影响）
RZYL_WINDOW_MESSAGE_LIMIT=30
# 一个窗口最多横跨多少分钟：到点且条数不少于最小条数时才成窗
RZYL_WINDOW_MINUTES=5
# 时间窗触发成窗时，缓冲里至少要有这么多条；不够就继续攒着。
# 稀疏流量下 5 分钟规则会把只有一两条消息的缓冲也收掉，白调一次模型却几乎提取不出东西。
RZYL_WINDOW_MIN_MESSAGES=5
# 兜底：缓冲里最老那条消息的年龄达到这么多分钟就无条件成窗（不看条数），
# 保证只发了一句话就安静下来的群也不会无限期滞留、永远不被提取。
RZYL_WINDOW_MAX_MINUTES=60
# 向量余弦去重阈值（同群同类别）
RZYL_DEDUPE_SIMILARITY_THRESHOLD=0.92

# —— 保留与推送 ——
# 原文滚动保留天数；记忆条目永久
RZYL_RETENTION_DAYS=30
# 每日推送时刻（0-23 / 0-59，按 RZYL_TIMEZONE）
RZYL_PUSH_HOUR=22
RZYL_PUSH_MINUTE=0
# 推送只列不低于该置信度的条目；入库不设门槛
RZYL_CONFIDENCE_THRESHOLD=0.7

# —— 提取 ——
# 一个窗口最多尝试提取几次（含首次）；用尽仍失败整窗进死信
RZYL_EXTRACT_MAX_ATTEMPTS=3
# 时区：自然日与推送时刻所依据
RZYL_TIMEZONE=Asia/Shanghai

# —— 实时链路的后台循环 ——
# 窗口超时刷新间隔（秒）：群里没人说话时靠它把未满缓冲按时成窗
RZYL_WINDOW_FLUSH_SECONDS=60
# 死信重试间隔（秒）
RZYL_DEAD_LETTER_RETRY_SECONDS=300
# 死信窗口被后台重试到 retry_count 达到该值就放弃
RZYL_DEAD_LETTER_MAX_RETRIES=5

# —— 掉线回补 ——
# 时间护栏：至多回补最近多少小时
RZYL_BACKFILL_MAX_HOURS=24
# 条数护栏：单个群一次最多回补多少条
RZYL_BACKFILL_MAX_MESSAGES=500
# 每页条数
RZYL_BACKFILL_PAGE_SIZE=20

# —— 存储 ——
# SQLite 连接串；容器内落在 bind mount 的 /app/data（宿主机 ./data）
RZYL_DATABASE_URL=sqlite+aiosqlite:///data/rzyl.db

# —— OneBot HTTP API（离线回放从 OneBot 拉历史时用；样本文件那条路不需要）——
# 容器网络内是 http://napcat:3000；本机默认没有发布该端口，留空即禁用 OneBot 来源。
# 注意：掉线回补走 NoneBot 的 bot.call_api，不依赖这一项。
RZYL_ONEBOT_API_ROOT=
# OneBot HTTP API 的 Bearer token；没有就留空。
RZYL_ONEBOT_ACCESS_TOKEN=

# —— 聊天模型 ——
# 留空即禁用记忆功能（机器人照常连 QQ，但明确不采集不落库）
RZYL_CHAT_API_KEY=
RZYL_CHAT_BASE_URL=https://api.deepseek.com/v1
RZYL_CHAT_MODEL=deepseek-chat
# 单次请求超时（秒）。给足：实测 Qwen3.5-4B 这类模型单次可到 50 秒以上
RZYL_CHAT_TIMEOUT=120
# 原样合并进请求 JSON 的额外字段（JSON 对象）。示例：硅基流动 Qwen3.5-4B 默认进思考
# 模式会挂死请求，必须带下面这个才正常返回；不用就留空。
RZYL_CHAT_EXTRA_BODY=
# RZYL_CHAT_EXTRA_BODY={"enable_thinking": false}
# 每百万 token 单价，用于记账估费（未配置按 0 估算）
RZYL_CHAT_INPUT_PRICE=0
RZYL_CHAT_OUTPUT_PRICE=0

# —— 向量服务 ——
# 留空则条目向量留空、由后台补算（不造假向量）；语义检索暂不可用
RZYL_EMBEDDING_API_KEY=
RZYL_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RZYL_EMBEDDING_MODEL=text-embedding-v4
RZYL_EMBEDDING_DIM=1024
# 每百万 token 单价（向量服务通常按输入 token 计费）
RZYL_EMBEDDING_PRICE=0
